# コピーして .env を作る: cp .env.example .env

# PostgreSQL（npm run db:local または docker compose up -d で起動）
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/kids_outdoor"

APP_BASE_URL="http://localhost:3000"

# 開発では未設定でもよい（本番は Secret Manager から渡す）
IP_HASH_SECRET="change-me"
STORAGE_LOCAL_SECRET="change-me"

# local = .storage/ に保存（開発用） / gcs = Cloud Storage（staging・本番）
STORAGE_DRIVER="local"
# GCS_RAW_BUCKET="kids-outdoor-stg-videos-raw"
# GCS_VIDEO_BUCKET="kids-outdoor-stg-videos"

# ffmpeg がない開発環境では、変換せずにコピーする
# FFMPEG_PATH="ffmpeg"
# FFPROBE_PATH="ffprobe"

# メール（未設定ならログに出すだけ）
# SENDGRID_API_KEY=""
# MAIL_FROM="no-reply@example.com"
# INQUIRY_TO_EMAIL="support@example.com"

# アバター画像の配信元（本番は assets バケット＋Cloud CDN のURL。未設定なら public/ から配信）
# NEXT_PUBLIC_ASSETS_BASE_URL="https://assets.example.com"
