{
  "name": "kids-outdoor-app",
  "version": "0.1.0",
  "private": true,
  "description": "子どもを外で遊ばせるアプリ（仮称）",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "avatars:generate": "tsx scripts/generate-avatar-placeholders.ts",
    "jobs": "tsx jobs/run.ts",
    "transcoder": "tsx transcoder/server.ts",
    "e2e": "node e2e/flow.mjs e2e/screenshots",
    "e2e:camera": "node e2e/camera.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.17.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.0",
    "kuromoji": "0.1.2",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "1.49.1",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
